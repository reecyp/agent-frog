# Copy to .env.local and fill in what you have. Everything is optional: missing services fall back
# to honest, clearly labeled alternatives (rule-based drafting, local database, employer boards only).

# Claude (Anthropic). Turns on AI parsing, tailoring, cover letters, questions and feedback.
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5).
# CLAUDE_MODEL=claude-opus-5-5

# Neon Postgres. Without it, data is stored in a local embedded Postgres under .data/.
# After setting it, run: npm run db:migrate
DATABASE_URL=

# Private TCU alumni spreadsheet. Defaults to ../Alumni_Networking_List_-_Fall_26_Update copy.xlsx
# Never commit this file; it is ignored by .gitignore.
# ALUMNI_DATA_PATH=

# Optional aggregator (developer.adzuna.com). Results are labeled unverified.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Deepgram (deepgram.com). Turns on spoken interview practice; transcripts keep "um" and "uh".
DEEPGRAM_API_KEY=
